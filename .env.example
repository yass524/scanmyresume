# Application
LOGIN_ENABLED=1
SESSION_SECRET=replace-with-a-long-random-value
APP_BASE_URL=http://localhost:8000
COOKIE_SECURE=0
MAX_RPM=120
MAX_UPLOAD_MB=8

# Database (omit for local SQLite; use managed Postgres in production)
# DB_URL=postgresql+psycopg://user:password@host:5432/database

# Groq AI grading
API_KEY=replace-with-your-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b
GROQ_REASONING_EFFORT=low
AI_GRADING_ON=1
AI_SCORE_WEIGHT=0.25
AI_MAX_ADJUSTMENT=10
AI_TIMEOUT_SECONDS=18

# Optional password-reset email
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# SMTP_STARTTLS=1
# SMTP_SSL=0
